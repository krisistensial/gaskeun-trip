{
  "rewrites": [
    {
      "source": "/((?!assets/|manifest\\.webmanifest|sw\\.js|workbox-.*|registerSW\\.js|pwa-.*\\.png|apple-touch-icon\\.png|favicon.*\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
